# Server-side only. Never expose either key through NEXT_PUBLIC_* variables.
OPEN_AI_KEY=your_openai_api_key_here
EXA_KEY=your_exa_api_key_here

# Optional server-side model overrides.
# OPENAI_INTELLIGENCE_MODEL=gpt-5.6-terra
# OPENAI_PAGE_AGENT_MODEL=gpt-5.6-terra

# Origin that serves the API routes. Leave empty for the same-origin demo.
# The injectable widget normally derives this from its script URL.
NEXT_PUBLIC_PROXY_BASE=http://localhost:3000

# Visual page-agent DOM highlights and automation mask. Disabled by default.
NEXT_PUBLIC_PAGE_AGENT_OVERLAY=false

# Chrome extension build target. Use your deployed HTTPS server for distribution.
# EXTENSION_PROXY_BASE=https://your-voicelayer-server.example

# After publishing, point the landing-page button to the Chrome Web Store listing.
# NEXT_PUBLIC_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/your-extension-id
