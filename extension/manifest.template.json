{
  "manifest_version": 3,
  "name": "SightSpeak — GPT-Live",
  "version": "1.0.0",
  "description": "Talk to the current webpage with OpenAI GPT-Live, page-agent, and Exa.",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "__VOICE_PROXY_HOST_PERMISSION__"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Turn SightSpeak off"
  }
}
